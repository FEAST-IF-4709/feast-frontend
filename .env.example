# ============================================
# FEAST Frontend — Environment Variables
# ============================================
# Copy file ini menjadi .env dan sesuaikan nilainya:
#   cp .env.example .env
# ============================================

# Base URL API Backend
# Untuk lokal: http://localhost:8000/api/v1
# Untuk ngrok: https://abc123.ngrok-free.app/api/v1
# Untuk production: https://api.domainmu.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL WebSocket
# Untuk lokal: ws://localhost:8000
# Untuk ngrok: wss://abc123.ngrok-free.app
# Untuk production: wss://api.domainmu.com
VITE_WS_BASE_URL=ws://localhost:8000

# Midtrans Client Key (opsional — untuk payment QRIS)
# Dapatkan dari dashboard Midtrans: https://dashboard.midtrans.com
VITE_MIDTRANS_CLIENT_KEY=

# Public App URL (untuk generate QR code customer-facing URL)
VITE_PUBLIC_APP_URL=https://app.feast.id
